  "item": [
    {
      "id": "406509af-2401-4e6d-82d1-faa0a71c97e6",
      "name": "Analytics Reports",
      "description": {
        "content": "Operations for retrieving YouTube Analytics reports and metrics",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a267a443-521c-4342-ada0-6afc864510ed",
          "name": "Retrieve YouTube Analytics Reports",
          "request": {
            "name": "Retrieve YouTube Analytics Reports",
            "description": {
              "content": "Retrieves YouTube Analytics data for a channel or content owner.\nThe API response contains a report with the requested dimensions and metrics\nfor the specified date range. You can filter results by various dimensions\nsuch as video, country, or traffic source.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reports"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "(Required) Identifies the YouTube channel or content owner for which you are retrieving\nYouTube Analytics data. Use channel==CHANNEL_ID or contentOwner==CONTENT_OWNER_ID.\n"
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<date>",
                  "description": "(Required) The start date for the data retrieval in YYYY-MM-DD format"
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<date>",
                  "description": "(Required) The end date for the data retrieval in YYYY-MM-DD format"
                },
                {
                  "disabled": false,
                  "key": "metrics",
                  "value": "<string>",
                  "description": "(Required) A comma-separated list of YouTube Analytics metrics to retrieve.\nCommon metrics include views, estimatedMinutesWatched, averageViewDuration, likes, dislikes, comments, shares.\n"
                },
                {
                  "disabled": false,
                  "key": "dimensions",
                  "value": "<string>",
                  "description": "A comma-separated list of YouTube Analytics dimensions.\nCommon dimensions include video, channel, country, day, month.\n"
                },
                {
                  "disabled": false,
                  "key": "filters",
                  "value": "<string>",
                  "description": "A list of filters to apply to the data. Filters use the format dimension==value\nand can be combined with semicolons.\n"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "A comma-separated list of dimensions or metrics to sort by.\nPrefix with - for descending order.\n"
                },
                {
                  "disabled": false,
                  "key": "maxResults",
                  "value": "100",
                  "description": "Maximum number of rows to include in the response (1-500)"
                },
                {
                  "disabled": false,
                  "key": "startIndex",
                  "value": "1",
                  "description": "Index of the first row to retrieve (1-based)"
                },
                {
                  "disabled": false,
                  "key": "currency",
                  "value": "<string>",
                  "description": "Currency code for revenue metrics (ISO 4217)"
                },
                {
                  "disabled": false,
                  "key": "access_token",
                  "value": "<string>",
                  "description": "OAuth 2.0 access token for authentication"
                },
                {
                  "disabled": false,
                  "key": "prettyPrint",
                  "value": "true",
                  "description": "Returns response with indentations and line breaks for readability"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
