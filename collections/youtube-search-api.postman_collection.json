                  "key": "part",
                  "value": "<string>",
                  "description": "(Required) Specifies a comma-separated list of one or more resource properties that the API response will include. The part parameter value must include the id property."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "The query term to search for."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
